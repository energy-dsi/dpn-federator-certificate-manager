<configuration>
    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>

    <!-- Standard Spring Boot include - keeps Spring's own default console conversion rules
         (colour conversion words etc.) available even though we don't use the default pattern
         for the active appender below; harmless if unused. -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="certificate-manager"/>

    <!-- Structured JSON console appender, matching the OpenTelemetry Log Data Model
         (see OtelJsonEncoder / OTEL_LOG_SAMPLES.md). This is the ACTIVE appender on <root>
         below. trace_id/span_id are populated automatically by Micrometer Tracing's MDC
         integration whenever a span is active - see application.yml's management.tracing.*
         config - with no code changes needed at individual log call sites. -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="uk.gov.dbt.ndtp.federator.certificate.manager.config.logging.OtelJsonEncoder">
            <serviceName>${appName}</serviceName>
        </encoder>
    </appender>

    <!-- Human-readable alternative appender, using this project's pre-existing console pattern
         (application.yml logging.pattern.console) extended with [traceId=][spanId=]. Not
         referenced by <root> below - swap JSON_CONSOLE for PLAIN_CONSOLE here for local
         debugging if structured JSON is harder to read by eye; one-line change, no other
         config affected. -->
    <appender name="PLAIN_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Exports log records to the OTLP Collector. The OpenTelemetry SDK/exporter is wired to
         this appender at runtime by OpenTelemetryLogsConfig via OpenTelemetryAppender.install();
         until that call runs the appender has no SDK and drops logs, so both must be present.
         trace_id/span_id are attached automatically from the active span; captureMdcAttributes
         additionally carries this project's custom clientId MDC field onto the exported record.
         captureKeyValuePairAttributes carries SLF4J 2.x addKeyValue(...) pairs onto the record -
         this is what makes HeartbeatEmitter's event.name / component.name / component.status /
         heartbeat.* attributes reach the otel-logs topic, so the health-monitoring dashboard's
         Component/Pipeline Health panels can see them. Matches the federator's OTEL appender. -->
    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureExperimentalAttributes>true</captureExperimentalAttributes>
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
        <captureMdcAttributes>clientId</captureMdcAttributes>
    </appender>

    <root level="INFO">
        <appender-ref ref="OTEL"/>
        <appender-ref ref="PLAIN_CONSOLE"/>
    </root>

</configuration>